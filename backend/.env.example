# Patty Project UK - Backend Environment Configuration Example
# Copy this file to .env for local overrides. NEVER commit .env to Git.

# Critical JWT Secret Key (Production requires min 32-character high-entropy random string)
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION_MIN_32_CHARS

# JWT Access Token Expiration in minutes (Default: 120 minutes / 2 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Application Environment (development / staging / production)
ENVIRONMENT=development
APP_ENV=development

# Database Connection URI (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///patty_project.db

# CORS Allowed Origins (Comma-separated in production)
BACKEND_CORS_ORIGINS=https://order.pattyproject.co.uk,https://admin.pattyproject.co.uk,https://pattyproject.co.uk

# Initial Admin Seeding (Production requires explicit high-entropy password)
# SEED_ADMIN_EMAIL=admin@pattyproject.co.uk
# SEED_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD_MIN_12_CHARS

# Payment Gateway Provider (mock / stripe / client_gateway)
PAYMENT_PROVIDER=mock

# Google Identity Services (GIS) OAuth Client ID
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
